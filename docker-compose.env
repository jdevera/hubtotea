# ----------------------------------------------
# Required Parameters
# ----------------------------------------------

# The github username to mirror repositories from
GITHUB_USERNAME=github_username

# The URL of the Forgejo instance that will be mirroring the repositories
FORGEJO_URL=forgejo_url

# The token to use when authenticating with the Forgejo API
FORGEJO_TOKEN=forgejo_token

# ----------------------------------------------
# Optional Parameters
# ----------------------------------------------

# A GitHub token is required when working with private or starred repositories
#GITHUB_TOKEN=XXXXXXXXX

# What to mirror:
# - public: All public repos of the given user, excluding forks
# - private: All private repos of the given user
# - forks: All forks of the given user (they are always public)

# Set to false or 0 to not mirror public repositories (by default public
# repositories are mirrored). This option does not include forks.
# The default is true.
#HUBTOJO_MIRROR_PUBLIC_REPOS=false

# Set to true or 1 to mirror private repositories (by default private
# repositories are not mirrored)
# The GITHUB_TOKEN environment variable must be set to a valid GitHub token
# in order to mirror private repositories
#HUBTOJO_MIRROR_PRIVATE_REPOS=true

# Set to true or 1 to mirror forks (by default forks are not mirrored)
#HUBTOJO_MIRROR_FORKS=true

# Set to true or 1 to mirror repositories starred by the authenticated GitHub
# user. Starred repositories are not affected by the public/private/fork filters.
#HUBTOJO_MIRROR_STARRED_REPOS=true

# Forgejo organization for third-party starred repositories. HubToJo creates it
# if missing. The default is github-stars.
#HUBTOJO_STARRED_ORG=github-stars

# Maximum number of missing starred repositories to attempt per run. Existing
# mirrors do not consume the limit, failed attempts do, and 0 means unlimited.
# The default is 25.
#HUBTOJO_MAX_STARRED_CREATES_PER_RUN=25

# Set to true or 1 to skip the write operations and instead just log them
# This is useful to see what repositories would be created without actually
# creating them
#HUBTOJO_DRY_RUN=true

# The number of concurrent workers to use when mirroring repositories.
# The default is 5.
#HUBTOJO_NUM_WORKERS=5

# The address for the status page and stats endpoint.
# The default is :8080.
#HUBTOJO_WEB_ADDR=:8080

# The interval in seconds to wait between syncs.
# Set to 0 to run only once. The default is 3600.
#HUBTOJO_SYNC_INTERVAL=3600

# Maximum duration in seconds for startup checks and each synchronization run.
# The default is 3600.
#HUBTOJO_RUN_TIMEOUT=3600
